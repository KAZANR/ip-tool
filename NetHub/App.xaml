<Application x:Class="NetHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBg" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
    <SolidColorBrush x:Key="Muted" Color="#64748B"/>
    <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Soft" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Blue" Color="#3B82F6"/>
    <SolidColorBrush x:Key="BlueDark" Color="#2563EB"/>
    <SolidColorBrush x:Key="Ok" Color="#16A34A"/>
    <SolidColorBrush x:Key="Warn" Color="#D97706"/>
    <SolidColorBrush x:Key="Bad" Color="#DC2626"/>
  </Application.Resources>
</Application>
