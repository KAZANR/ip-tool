<Window x:Class="NetworkDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Doctor"
        Width="1180"
        Height="780"
        MinWidth="1000"
        MinHeight="640"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F8F9FC" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <Grid Margin="28,28,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center" Width="180">
                    <Border Width="54" Height="54" CornerRadius="15" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Network Doctor" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="网络急救工具" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Width="180" Margin="0,52,0,0">
                    <Button Style="{StaticResource NavButton}" Background="{StaticResource AccentBrush}" Foreground="White" Content="检测与修复" />
                    <Button Style="{StaticResource NavButton}" Content="使用说明" />
                    <Button Style="{StaticResource NavButton}" Content="关于工具" />
                </StackPanel>
                <Border Grid.Row="3" Width="180" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="11" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="本机安全处理" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="9,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="网络检测" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="发现遗留代理并快速恢复网络连接" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CheckButton" Style="{StaticResource SecondaryButton}" Click="CheckButton_Click" Content="重新检测" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1.45*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="3">
                        <TextBlock Text="Basic Components" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="先用检测确认问题，再决定是否关闭代理。所有操作都会保留可撤销记录。" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,24,0,0" />

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBackgroundBrush}" Padding="20" Margin="0,22,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="网络健康" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0">
                                <TextBlock x:Name="ScoreText" Text="—" FontSize="52" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="/ 100" FontSize="15" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,8" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock x:Name="ScoreCaption" Text="等待检测" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatusText" Text="点击开始检测，系统会自动检查代理设置" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBackgroundBrush}" Padding="20" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="快速处理" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="一键关闭遗留代理" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,0" />
                            <TextBlock Text="先备份，再关闭，最后测试网站访问。" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="StartCheckButton" Style="{StaticResource PrimaryButton}" Click="StartCheckButton_Click" Content="开始检测" Margin="0,0,9,0" />
                                <Button x:Name="RepairButton" Style="{StaticResource PrimaryButton}" Click="RepairButton_Click" Content="关闭代理" IsEnabled="False" />
                                <Button x:Name="RestoreButton" Style="{StaticResource SecondaryButton}" Click="RestoreButton_Click" Content="撤销" Margin="9,0,0,0" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,26,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="检查项目" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" x:Name="FindingsSummary" Text="尚未检测" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ProgressBar Grid.Row="1" x:Name="CheckProgress" Height="4" Margin="0,14,0,4" Foreground="{StaticResource AccentBrush}" Background="#E4E8EF" BorderThickness="0" Visibility="Collapsed" />
                        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FindingsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="155" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Source}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" />
                                                <StackPanel Grid.Column="3" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Address}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Impact}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="本机处理，不上传数据  ·  不会执行未知命令" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
        </Grid>
    </Grid>
</Window>
